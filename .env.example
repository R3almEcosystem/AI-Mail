# r3alm mail account (password intentionally not stored in Git)
MAIL_USERNAME=admin@r3alm.com
MAIL_PASSWORD=

# Incoming mail — implicit TLS
IMAP_HOST=mail.r3alm.com
IMAP_PORT=993
IMAP_SECURE=true

# Outgoing mail — implicit TLS
SMTP_HOST=mail.r3alm.com
SMTP_PORT=465
SMTP_SECURE=true

# MCP HTTP service (used by local/Docker execution; Vercel supplies its own listener)
HOST=0.0.0.0
PORT=3000

# Comma-separated public hostnames accepted by the DNS-rebinding guard.
# On Vercel, VERCEL_URL, VERCEL_BRANCH_URL and VERCEL_PROJECT_PRODUCTION_URL
# are automatically added when Vercel System Environment Variables are exposed.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Administrative/API fallback bearer token.
# ChatGPT uses short-lived Supabase OAuth tokens instead.
# Generate a long random value (for example: openssl rand -hex 32).
MCP_API_TOKEN=

# Supabase OAuth 2.1 / OIDC configuration.
# The production defaults are compiled into v0.3.1; these variables allow override.
SUPABASE_URL=https://wmqhvsiwarfpfaesctrd.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_1bi9-ZkzbzCovzd35j1S2w_80Zyq6bY
OAUTH_CLIENT_ID=77ee233c-8001-4318-acec-8d713fec56ba
OAUTH_RESOURCE=https://ai-mail.r3alm.com/mcp
OAUTH_ALLOWED_EMAILS=key@r3alm.com

# Safety controls
MAX_MESSAGE_BODY_CHARS=50000
MAX_RAW_MESSAGE_BYTES=10000000
MAX_SEARCH_RESULTS=50
MAX_RECIPIENTS=20
# Optional comma-separated egress domain allowlist, e.g. r3alm.com,example.com.
# Empty means any syntactically valid recipient is allowed.
OUTBOUND_ALLOWED_DOMAINS=
