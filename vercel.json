{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "functions": {
    "src/app/mcp/route.ts": {
      "maxDuration": 60
    }
  },
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "node scripts/verify-core.cjs && npm run build",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
