{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/config.ts",
    "src/security.ts",
    "src/mail/**/*.ts",
    "src/oauth/**/*.ts",
    "src/mcp/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
