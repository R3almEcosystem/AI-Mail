{
  "name": "@r3alm/ai-mail",
  "version": "0.4.1",
  "private": true,
  "description": "Unified direct-user and ChatGPT AI-Mail application for r3alm.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:phase1",
    "test:phase1": "node --test tests/phase1-*.cjs",
    "check": "npm run typecheck && npm test",
    "gateway:dev": "tsx watch src/index.ts",
    "gateway:build": "tsc -p tsconfig.gateway.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.54",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "ai": "7.0.88",
    "express": "5.2.1",
    "imapflow": "1.6.5",
    "jose": "6.1.0",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "nodemailer": "10.0.10",
    "postal-mime": "2.7.5",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tsx": "4.22.5",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  },
  "packageManager": "npm@10.9.2"
}
